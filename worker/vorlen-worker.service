[Unit]
Description=Vorlen dedicated background worker
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=vorlen-worker
Group=vorlen-worker
WorkingDirectory=/opt/vorlen-worker
ExecStart=/opt/vorlen-session-venv/bin/python /opt/vorlen-worker/worker.py
EnvironmentFile=-/etc/vorlen-worker/worker.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=VORLEN_WORKER_STATE_DIR=/var/lib/vorlen-worker
Restart=on-failure
RestartSec=5
StateDirectory=vorlen-worker
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=220M
TasksMax=50
TimeoutStopSec=25
[Install]
WantedBy=multi-user.target
