# Names only. Supply real values through your local runtime or hosting secret settings.
# Cloudflare Workers uses .dev.vars for local bindings; copy these names there privately.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CREDENTIAL_ENCRYPTION_KEY=
ZERNIO_API_KEY=
ZERNIO_OWNER_ID=

# Vercel server-only configuration; set actual values in Vercel environment settings.
ZERNIO_API_KEY=replace_in_vercel_secrets
ZERNIO_OWNER_ID=preserve_original_workspace_owner_id
APP_ORIGIN=https://your-production-domain.example
VORLEN_SESSION_KEY=replace_with_new_64_hex_characters
VORLEN_AUTH_BRIDGE_KEY=replace_with_shared_64_hex_characters
VORLEN_MCP_API_KEY=replace_with_new_64_hex_characters

# Production-only bearer shared with the Supabase Vault scheduler secret.
VORLEN_SCHEDULER_SECRET=replace_with_random_64_hex_characters
